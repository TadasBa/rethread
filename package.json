{
  "name": "rethread",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Rethread — Lithuanian clothing repair service. Custom Vite + TS front end, deployed to Cloudflare Pages.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/gen-seo.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test scripts/*.test.mjs",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "pages:dev": "wrangler pages dev dist --compatibility-date=2024-11-01",
    "fonts": "node scripts/fetch-fonts.mjs"
  },
  "dependencies": {
    "lenis": "^1.1.18",
    "marked": "^14.1.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wrangler": "^3.90.0"
  },
  "engines": {
    "node": ">=20.20.0",
    "npm": ">=10.8.0"
  }
}
